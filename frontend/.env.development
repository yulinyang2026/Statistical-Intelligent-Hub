# ============================================================================
# 【开发】环境变量（仅 pnpm dev / vite 运行时加载）
#
# 加载时机：执行 pnpm dev 时，在 .env 基础上叠加本文件（同名变量以本文件为准）。
# 修改本文件后必须重启 pnpm dev 才生效。
# ============================================================================

# 应用部署基础路径（开发环境保持 / 即可）
VITE_BASE_URL = /

# API 请求基础路径
# 用法：src/utils/http/index.ts → axios baseURL；wang-editor 上传地址也拼它
# 开发环境填 / ：页面里 /api 开头的请求走同源（http://localhost:3006/api/...），
# 由下方 VITE_API_PROXY_URL 的 Vite 代理转发到后端，从而规避浏览器跨域限制
VITE_API_URL = /

# 开发代理目标地址（联调后端的关键配置）
# 用法：vite.config.ts → server.proxy，把 /api 开头的请求转发到此地址
# 2026-09-09 起指向本地后端（此前为 Apifox mock，接口全部返回模拟数据）
# 联调其他环境时改这里即可，例如后端同事的 IP：http://192.168.x.x:8080
VITE_API_PROXY_URL = http://localhost:8080

# 是否剔除构建产物中的 console 语句
# ⚠️ 说明：当前 vite.config.ts 在生产构建（pnpm build）中已硬编码 drop_console: true，
# 本变量暂未被构建脚本读取，仅保留作为将来改为变量控制的约定位；开发模式不剔除
VITE_DROP_CONSOLE = false
