# ============================================================================
# 【生产】环境变量（仅 pnpm build 构建 / pnpm serve 预览时加载）
#
# 加载时机：pnpm build 或 pnpm serve 时，在 .env 基础上叠加本文件
# （同名变量以本文件为准）。修改后必须重新构建才生效。
# 注意：生产环境没有 Vite 开发代理，页面直接请求下方 VITE_API_URL 的地址。
# ============================================================================

# 应用部署基础路径
# 部署在域名根目录保持 /；部署在子目录（如 /admin）时改为 /admin/
VITE_BASE_URL = /

# API 请求基础路径（生产环境前端直连后端，不走代理）
# 用法：src/utils/http/index.ts → axios baseURL；wang-editor 上传地址也拼它
# ⚠️ 当前值仍是 Apifox mock 地址（联调遗留），正式部署前必须改为真实后端地址，
# 例如：https://your-backend-domain.com
# 前端请求 /api/xxx 会拼成 https://your-backend-domain.com/api/xxx，后端需允许该来源跨域
VITE_API_URL = https://m1.apifoxmock.com/m1/6400575-6097373-default

# 是否剔除构建产物中的 console 语句
# ⚠️ 说明：当前 vite.config.ts 在生产构建中已硬编码 drop_console: true，
# 本变量暂未被构建脚本读取，仅保留作为将来改为变量控制的约定位
VITE_DROP_CONSOLE = true
