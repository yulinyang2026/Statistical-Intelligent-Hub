# ============================================================================
# 【通用】环境变量（所有模式共享的基础配置）
#
# 本文件无论开发（pnpm dev）还是构建（pnpm build）都会加载，定义各模式通用的默认值。
#
# Vite 环境变量加载顺序（同名字段后者覆盖前者）：
#   .env               ← 本文件，通用默认值
#   .env.development   ← 仅开发模式（pnpm dev）加载，可覆盖本文件
#   .env.production    ← 仅生产构建（pnpm build）/预览（pnpm serve）加载，可覆盖本文件
#
# 读取方式：
#   - 前端代码：仅 VITE_ 前缀的变量会注入浏览器端，用 import.meta.env.VITE_XXX 读取
#   - 构建脚本：vite.config.ts 用 loadEnv(mode, root) 读取（不限前缀）
# 修改任何变量后必须重启 dev server / 重新构建才生效。
# ============================================================================

# 应用版本号
# 用法：vite.config.ts 注入为全局常量 __APP_VERSION__，页面展示当前版本（如页脚/关于弹窗）
VITE_VERSION = 3.0.2

# 开发服务器端口
# 用法：vite.config.ts → server.port。pnpm dev 时浏览器访问 http://localhost:3006
# 若端口被占用，Vite 会自动顺延到 3007、3008……（以终端输出为准）
VITE_PORT = 3006

# 应用部署基础路径
# 用法：vite.config.ts → base，决定打包产物中静态资源的引用前缀
# 部署在域名根目录保持 /；部署在子目录（如 /admin）时改为 /admin/
VITE_BASE_URL = /

# 权限模式（菜单与按钮权限的来源）
# 用法：src/hooks/core/useAppMode.ts 读取
#   frontend = 前端模式：菜单由 src/router/modules/ 静态定义，适合演示与小型项目
#   backend  = 后端模式：菜单与权限码由后端接口下发（/api/v3/system/menus），适合企业级动态权限
VITE_ACCESS_MODE = frontend

# 跨域请求是否携带 Cookie
# 用法：src/utils/http/index.ts → axios withCredentials
# 本项目鉴权走 Authorization: Bearer 请求头，不依赖 Cookie，保持 false；
# 若后端改为 Cookie 会话且跨域，需设为 true 并同步后端 CORS 配置
VITE_WITH_CREDENTIALS = false

# 是否显示路由信息调试面板
# 用法：src/components/core/layouts/art-page-content 右下角显示当前路由详情（开发调试用）
VITE_OPEN_ROUTE_INFO = false

# 锁屏密码加密密钥
# 用法：src/components/core/layouts/art-screen-lock 用 CryptoJS 对锁屏口令加密存储
# ⚠️ 正式上线前务必更换为自己的随机字符串
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro
